{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "legwork-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Local dev listens on every interface so a phone on the same network (or
  // Tailscale) can reach the API. Pair it with ALLOWED_ORIGINS in .dev.vars.
  "dev": { "ip": "0.0.0.0", "port": 8787 },
  "vars": {
    "ENVIRONMENT": "production",
    // Comma-separated list of origins allowed to call the API.
    "ALLOWED_ORIGINS": "https://legwork-web.7d224y5qc9.workers.dev",
    // OpenRouter model for reading job photos. The key is a secret: OPENROUTER_API_KEY.
    "VISION_MODEL": "openai/gpt-6.2-sol",
    // OpenRouter model that screens requests before intake prices them (#98). See docs/screening-eval.md.
    "SCREEN_MODEL": "google/gemini-3.5-flash-lite"
  },
  // Secrets (not in this file): ANTHROPIC_API_KEY, OPENROUTER_API_KEY. Local: .dev.vars.
  // Deployed: `pnpm --filter @legwork/api exec wrangler secret put ANTHROPIC_API_KEY`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "legwork",
      "database_id": "304d1dc5-df54-4ec7-b942-16c045d2b383",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "legwork-photos" }
  ]
}
