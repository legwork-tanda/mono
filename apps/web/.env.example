# Base URL of the API worker for production builds. Inlined at build time.
# In development the app uses the page's own host on port 8787 instead.
NEXT_PUBLIC_API_URL=http://localhost:8787
# Development only: call the API here instead (e.g. an HTTPS tunnel for testing GPS
# on a phone; see the README). Leave unset normally.
# NEXT_PUBLIC_DEV_API_URL=https://<api>.trycloudflare.com
