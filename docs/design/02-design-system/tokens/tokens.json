{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Legwork design tokens v0.3 (21 Nov 2026). Source of truth. tokens.css and LegworkTokens.swift are generated from this file by build_tokens.py. Colour tokens under color.semantic carry a dark value in $extensions[\"app.legwork.modes\"].dark. Light is the $value.",

  "color": {
    "primitive": {
      "yellow":         { "$type": "color", "$value": "#FFE37A", "$description": "The one accent. Always a fill with ink on it. Never text." },
      "yellow-pressed": { "$type": "color", "$value": "#F5D35A" },
      "yellow-tint":    { "$type": "color", "$value": "#FFF8DC" },
      "ink":            { "$type": "color", "$value": "#1D1D1F", "$description": "Every headline and body on light. 16.8:1 on white." },
      "ink-2":          { "$type": "color", "$value": "#3A3A3C" },
      "ink-3":          { "$type": "color", "$value": "#5E5E63", "$description": "Darkened from #6E6E73 in v0.3 so captions pass 4.5:1 on light glass over the darkest photo." },
      "grey-disabled":  { "$type": "color", "$value": "#7A7A7A" },
      "white":          { "$type": "color", "$value": "#FFFFFF" },
      "black":          { "$type": "color", "$value": "#000000" },
      "parchment":      { "$type": "color", "$value": "#F5F5F7" },
      "hairline":       { "$type": "color", "$value": "#E0E0E0" },
      "tile-1":         { "$type": "color", "$value": "#272729" },
      "tile-2":         { "$type": "color", "$value": "#2A2A2C" },
      "tile-3":         { "$type": "color", "$value": "#252527" },
      "grey-dark-line": { "$type": "color", "$value": "#3A3A3C" },
      "grey-on-dark-2": { "$type": "color", "$value": "#E5E5EA" },
      "grey-on-dark-3": { "$type": "color", "$value": "#AEAEB2" },
      "grey-on-dark-4": { "$type": "color", "$value": "#86868B" }
    },

    "semantic": {
      "accent":          { "$type": "color", "$value": "{color.primitive.yellow}", "$description": "Primary action fill, PIN digits, selected chip, tape. Same in both modes.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.yellow}" } } },
      "accent-pressed":  { "$type": "color", "$value": "{color.primitive.yellow-pressed}", "$description": "Rarely used: press is a scale, not a colour.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.yellow-pressed}" } } },
      "accent-tint":     { "$type": "color", "$value": "{color.primitive.yellow-tint}", "$description": "Quiet highlight behind a note.", "$extensions": { "app.legwork.modes": { "dark": "rgba(255,227,122,0.14)" } } },
      "on-accent":       { "$type": "color", "$value": "{color.primitive.ink}", "$description": "The only colour allowed on yellow. 13.2:1.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.ink}" } } },

      "text":            { "$type": "color", "$value": "{color.primitive.ink}", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.white}" } } },
      "text-2":          { "$type": "color", "$value": "{color.primitive.ink-2}", "$description": "Secondary copy on glass.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.grey-on-dark-2}" } } },
      "text-3":          { "$type": "color", "$value": "{color.primitive.ink-3}", "$description": "Tertiary: captions, placeholders, meta.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.grey-on-dark-3}" } } },
      "text-disabled":   { "$type": "color", "$value": "{color.primitive.grey-disabled}", "$description": "Disabled labels and legal fine print only.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.grey-on-dark-4}" } } },
      "text-on-photo":   { "$type": "color", "$value": "{color.primitive.white}", "$description": "Headline set straight on a photo (home). Needs the photo shade.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.white}" } } },
      "link":            { "$type": "color", "$value": "{color.primitive.ink}", "$description": "Links are ink and underlined, never yellow.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.white}" } } },

      "canvas":          { "$type": "color", "$value": "{color.primitive.white}", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.black}" } } },
      "canvas-alt":      { "$type": "color", "$value": "{color.primitive.parchment}", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.tile-3}" } } },
      "surface":         { "$type": "color", "$value": "{color.primitive.white}", "$description": "Solid card, sheet or field (when not glass).", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.tile-1}" } } },
      "fill":            { "$type": "color", "$value": "{color.primitive.parchment}", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.tile-2}" } } },
      "hairline":        { "$type": "color", "$value": "{color.primitive.hairline}", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.grey-dark-line}" } } },
      "selected":        { "$type": "color", "$value": "{color.primitive.ink}", "$description": "2px ring on a selected option card or chip.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.white}" } } },
      "error-ring":      { "$type": "color", "$value": "{color.primitive.ink}", "$description": "No red. Errors are a 2px ring plus a bold note.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.white}" } } },

      "glass-bg":           { "$type": "color", "$value": "rgba(255,255,255,0.58)", "$extensions": { "app.legwork.modes": { "dark": "rgba(30,30,32,0.52)" } } },
      "glass-bg-sheet":     { "$type": "color", "$value": "rgba(255,255,255,0.84)", "$description": "Glass for bottom sheets over busy content (Request status). Denser so the page behind doesn't compete.", "$extensions": { "app.legwork.modes": { "dark": "rgba(30,30,32,0.88)" } } },
      "glass-ring":         { "$type": "color", "$value": "rgba(255,255,255,0.70)", "$description": "1px inner ring.", "$extensions": { "app.legwork.modes": { "dark": "rgba(255,255,255,0.14)" } } },
      "glass-highlight":    { "$type": "color", "$value": "rgba(255,255,255,0.95)", "$description": "1px top inner highlight.", "$extensions": { "app.legwork.modes": { "dark": "rgba(255,255,255,0.22)" } } },
      "glass-shadow":       { "$type": "color", "$value": "rgba(0,0,0,0.14)", "$extensions": { "app.legwork.modes": { "dark": "rgba(0,0,0,0.35)" } } },
      "glass-inner":        { "$type": "color", "$value": "rgba(255,255,255,0.55)", "$description": "Well inside a glass panel (input, PIN row, tip).", "$extensions": { "app.legwork.modes": { "dark": "rgba(255,255,255,0.07)" } } },
      "glass-inner-highlight": { "$type": "color", "$value": "rgba(255,255,255,0.90)", "$extensions": { "app.legwork.modes": { "dark": "rgba(255,255,255,0.12)" } } },
      "glass-line":         { "$type": "color", "$value": "rgba(0,0,0,0.08)", "$description": "Dividers and chip rings on glass.", "$extensions": { "app.legwork.modes": { "dark": "rgba(255,255,255,0.10)" } } },
      "photo-wash":         { "$type": "color", "$value": "rgba(245,245,247,0.50)", "$description": "Over a blurred photo background.", "$extensions": { "app.legwork.modes": { "dark": "rgba(0,0,0,0.45)" } } },
      "photo-wash-strong":  { "$type": "color", "$value": "rgba(245,245,247,0.74)", "$description": "Over the blurred photo on list-heavy screens.", "$extensions": { "app.legwork.modes": { "dark": "rgba(0,0,0,0.60)" } } },

      "bubble-out":      { "$type": "color", "$value": "{color.primitive.ink}", "$description": "Customer's own chat bubble.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.white}" } } },
      "on-bubble-out":   { "$type": "color", "$value": "{color.primitive.white}", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.ink}" } } },

      "tape-a":          { "$type": "color", "$value": "{color.primitive.yellow}", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.yellow}" } } },
      "tape-b":          { "$type": "color", "$value": "{color.primitive.ink}", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.ink}" } } },

      "map-base":        { "$type": "color", "$value": "#ECECEF", "$extensions": { "app.legwork.modes": { "dark": "#1C1C1E" } } },
      "map-road":        { "$type": "color", "$value": "#FFFFFF", "$extensions": { "app.legwork.modes": { "dark": "#303034" } } },
      "map-road-minor":  { "$type": "color", "$value": "#F7F7F9", "$extensions": { "app.legwork.modes": { "dark": "#27272A" } } },
      "map-route":       { "$type": "color", "$value": "{color.primitive.yellow}", "$description": "Route line: 5px yellow over a 9px ink casing.", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.yellow}" } } },
      "map-route-casing":{ "$type": "color", "$value": "{color.primitive.ink}", "$extensions": { "app.legwork.modes": { "dark": "{color.primitive.ink}" } } }
    }
  },

  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["SF Pro Display", "-apple-system", "Inter", "sans-serif"], "$description": "iOS: the system font. Inter (bundled) is the web/off-Apple stand-in only." },
      "text":    { "$type": "fontFamily", "$value": ["SF Pro Text", "-apple-system", "Inter", "sans-serif"] }
    },
    "weight": {
      "light":    { "$type": "fontWeight", "$value": 300 },
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },

  "typography": {
    "$description": "App type scale. 'relativeTo' is the iOS Dynamic Type style each one scales with. No weight 500.",
    "display":     { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "34px", "fontWeight": 600, "lineHeight": 1.06, "letterSpacing": "-0.374px" }, "$extensions": { "app.legwork.relativeTo": "largeTitle" }, "$description": "Home headline: What needs fixing?" },
    "title-1":     { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "32px", "fontWeight": 600, "lineHeight": 1.12, "letterSpacing": "-0.374px" }, "$extensions": { "app.legwork.relativeTo": "largeTitle" }, "$description": "Screen title: When should someone come?" },
    "title-2":     { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "22px", "fontWeight": 600, "lineHeight": 1.2,  "letterSpacing": "-0.2px" },   "$extensions": { "app.legwork.relativeTo": "title2" }, "$description": "Card title, job title." },
    "title-3":     { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.2,  "letterSpacing": "-0.2px" },   "$extensions": { "app.legwork.relativeTo": "title3" }, "$description": "Tradie name, What I understood headline." },
    "headline":    { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontSize": "17px", "fontWeight": 600, "lineHeight": 1.24, "letterSpacing": "-0.374px" }, "$extensions": { "app.legwork.relativeTo": "headline" }, "$description": "Row title, nav title, button label." },
    "body":        { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.47, "letterSpacing": "-0.374px" }, "$extensions": { "app.legwork.relativeTo": "body" } },
    "callout":     { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.38, "letterSpacing": "-0.3px" },   "$extensions": { "app.legwork.relativeTo": "callout" }, "$description": "Chat bubbles, list rows." },
    "subhead":     { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.3,  "letterSpacing": "-0.2px" },   "$extensions": { "app.legwork.relativeTo": "subheadline" }, "$description": "Chips, links, status rows." },
    "caption":     { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.4,  "letterSpacing": "-0.15px" },  "$extensions": { "app.legwork.relativeTo": "footnote" }, "$description": "Secondary lines under a title." },
    "label":       { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.0,  "letterSpacing": "-0.1px" },   "$extensions": { "app.legwork.relativeTo": "footnote" }, "$description": "Tape label, section label." },
    "footnote":    { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.3,  "letterSpacing": "0px" },      "$extensions": { "app.legwork.relativeTo": "caption" }, "$description": "Meta: job number, step labels, legal." },
    "badge":       { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.0,  "letterSpacing": "0px" },      "$extensions": { "app.legwork.relativeTo": "caption" }, "$description": "Licensed / Insured badge, yellow tag." },
    "pin":         { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "26px", "fontWeight": 600, "lineHeight": 1.0,  "letterSpacing": "0px" },      "$extensions": { "app.legwork.relativeTo": "title2", "app.legwork.numeric": "tabular" }, "$description": "One PIN digit." },
    "figure":      { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "48px", "fontWeight": 600, "lineHeight": 1.0,  "letterSpacing": "-0.5px" },   "$extensions": { "app.legwork.relativeTo": "largeTitle", "app.legwork.numeric": "tabular" }, "$description": "Big number: enlarged PIN, amount to approve, total." }
  },

  "space": {
    "$description": "8-based with Apple's 17. Layout tokens below are the ones screens actually use.",
    "xxs": { "$type": "dimension", "$value": "4px" },
    "xs":  { "$type": "dimension", "$value": "8px" },
    "sm":  { "$type": "dimension", "$value": "12px" },
    "md":  { "$type": "dimension", "$value": "16px" },
    "lg":  { "$type": "dimension", "$value": "24px" },
    "xl":  { "$type": "dimension", "$value": "32px" },
    "xxl": { "$type": "dimension", "$value": "48px" }
  },

  "layout": {
    "screen-margin":    { "$type": "dimension", "$value": "20px", "$description": "Text and titles from the screen edge." },
    "glass-inset":      { "$type": "dimension", "$value": "12px", "$description": "Glass panels from the screen edge." },
    "glass-padding":    { "$type": "dimension", "$value": "18px", "$description": "Inside a glass panel." },
    "inner-padding":    { "$type": "dimension", "$value": "14px", "$description": "Inside an inner well." },
    "stack-gap":        { "$type": "dimension", "$value": "10px", "$description": "Between stacked glass panels and chat items." },
    "bottom-safe":      { "$type": "dimension", "$value": "30px", "$description": "Bottom panel to screen bottom (sits above the home indicator)." },
    "button-bottom":    { "$type": "dimension", "$value": "34px", "$description": "Bottom CTA to screen bottom." },
    "top-bar-content":  { "$type": "dimension", "$value": "58px", "$description": "Floating top controls from screen top (below the status bar)." }
  },

  "size": {
    "tap-min":         { "$type": "dimension", "$value": "44px" },
    "button-height":   { "$type": "dimension", "$value": "54px", "$description": "Primary pill." },
    "button-height-secondary": { "$type": "dimension", "$value": "50px" },
    "button-height-compact":   { "$type": "dimension", "$value": "44px" },
    "chip-height":     { "$type": "dimension", "$value": "40px" },
    "chip-height-compact": { "$type": "dimension", "$value": "34px" },
    "icon-button":     { "$type": "dimension", "$value": "44px" },
    "mic-button":      { "$type": "dimension", "$value": "48px" },
    "avatar":          { "$type": "dimension", "$value": "56px" },
    "avatar-row":      { "$type": "dimension", "$value": "44px" },
    "pin-digit-w":     { "$type": "dimension", "$value": "40px" },
    "pin-digit-h":     { "$type": "dimension", "$value": "50px" },
    "icon-row":        { "$type": "dimension", "$value": "20px" },
    "icon-bar":        { "$type": "dimension", "$value": "22px" },
    "icon-chip":       { "$type": "dimension", "$value": "16px" },
    "tape-edge":       { "$type": "dimension", "$value": "8px", "$description": "Tape along the top of the booked card." },
    "tape-loader":     { "$type": "dimension", "$value": "12px" },
    "stepper-bar":     { "$type": "dimension", "$value": "4px" }
  },

  "radius": {
    "xs":     { "$type": "dimension", "$value": "6px",  "$description": "Badge." },
    "sm":     { "$type": "dimension", "$value": "8px",  "$description": "Photo thumb, inline image." },
    "md":     { "$type": "dimension", "$value": "11px", "$description": "PIN digit, field." },
    "lg":     { "$type": "dimension", "$value": "18px", "$description": "Inner well." },
    "bubble": { "$type": "dimension", "$value": "20px", "$description": "Chat bubble (6px on the tail corner)." },
    "glass":  { "$type": "dimension", "$value": "26px", "$description": "Glass panel." },
    "pill":   { "$type": "dimension", "$value": "999px", "$description": "Every action and choice." }
  },

  "effect": {
    "glass-blur":        { "$type": "dimension", "$value": "26px", "$description": "Background blur radius. iOS: .ultraThinMaterial is close; see DESIGN.md." },
    "glass-saturation":  { "$type": "number", "$value": 1.8 },
    "glass-shadow":      { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px", "color": "{color.semantic.glass-shadow}" } },
    "photo-shadow":      { "$type": "shadow", "$value": { "offsetX": "3px", "offsetY": "5px", "blur": "30px", "spread": "0px", "color": "rgba(0,0,0,0.22)" }, "$description": "Only on a photo resting on a surface." },
    "photo-blur":        { "$type": "dimension", "$value": "16px" },
    "photo-grayscale":   { "$type": "number", "$value": 1, "$description": "All photos are black and white." },
    "photo-dim-dark":    { "$type": "number", "$value": 0.55, "$description": "Brightness of photos in dark mode." },
    "tape-angle":        { "$type": "number", "$value": -45 },
    "tape-stripe":       { "$type": "dimension", "$value": "10px", "$description": "Each stripe on standard tape." },
    "tape-stripe-fine":  { "$type": "dimension", "$value": "6px", "$description": "Each stripe on fine tape (label ends, list marker)." }
  },

  "motion": {
    "press-scale":   { "$type": "number", "$value": 0.96, "$description": "Every tappable. Never below 0.95. No hover." },
    "duration-fast": { "$type": "duration", "$value": "150ms" },
    "duration-base": { "$type": "duration", "$value": "250ms" },
    "duration-enter":{ "$type": "duration", "$value": "350ms" },
    "duration-exit": { "$type": "duration", "$value": "200ms", "$description": "Exits are shorter than entrances." },
    "stagger":       { "$type": "duration", "$value": "100ms" },
    "enter-offset":  { "$type": "dimension", "$value": "12px" },
    "enter-blur":    { "$type": "dimension", "$value": "4px" },
    "ease":          { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1] },
    "ease-out":      { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "tape-loader-cycle": { "$type": "duration", "$value": "1100ms" }
  }
}
